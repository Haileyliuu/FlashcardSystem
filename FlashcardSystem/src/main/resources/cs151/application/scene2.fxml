<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.application.controller.Scene2Controller"
      alignment="TOP_CENTER"
      spacing="20">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>
        <Label text="Define Deck" style="-fx-font-size: 50;"/>

        <Label text="Deck name:" style="-fx-font-size: 20;"/>

        <TextField fx:id="deckNameField" maxWidth="300"/>

        <Label text="Deck description (optional):" style="-fx-text-fill: grey;"/>

        <TextArea fx:id="deckDescriptionArea"
                  maxWidth="400"
                  maxHeight="100"
                  wrapText="true"/>

        <HBox alignment="CENTER" spacing="40">
            <children>
                <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"/>
                <Button fx:id="saveButton" text="Save" onAction="#handleSave"/>
            </children>
        </HBox>
    </children>
</VBox>