<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.application.controller.DefineFlashcardScene">

    <children>
        <VBox spacing="20" prefWidth="200" style="-fx-background-color: #121212;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <Label text="Home"/>
                <Label text="Library"/>
                <Label text="Folders"/>
            </children>
        </VBox>

        <ScrollPane fitToWidth="true">
            <content>
                <VBox fx:id="mainContent" spacing="40" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="40" right="40" bottom="40" left="40"/>
                    </padding>

                    <children>
                        <Label fx:id="defineFlashcardsLabel"
                               alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               translateX="10"
                               translateY="10"
                               styleClass="header-text"
                               style="-fx-font-size: 30;" />

                        <VBox fx:id="listFlashcards"
                              spacing="25"
                              alignment="CENTER" />

                        <HBox spacing="20"
                              alignment="CENTER_RIGHT"
                              maxWidth="700">
                            <children>
                                <Button fx:id="cancelButton"
                                        text="Cancel"
                                        onAction="#handleCancel"/>
                                <Button fx:id="saveButton"
                                        text="Save"
                                        onAction="#handleSave"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</HBox>