<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="cs151.application.controller.Scene4Controller"
            style="-fx-background: #1e1e1e; -fx-background-color: #1e1e1e;">

    <content>
        <VBox fx:id="deckView"
              spacing="20"
              style="-fx-background-color: #1e1e1e;">
            <padding>
                <Insets top="10" right="0" bottom="0" left="10"/>
            </padding>

            <children>
                <Button fx:id="backButton" text="Back" onAction="#handleBack"/>

                <HBox spacing="30">
                    <children>
                        <Label fx:id="deckNameLabel" style="-fx-font-size: 30;"/>
                        <Label fx:id="flashcardAmountLabel" style="-fx-font-size: 30;"/>
                    </children>
                </HBox>

                <TableView fx:id="flashcardTable"
                           prefHeight="400"
                           prefWidth="1000"
                           maxWidth="1.7976931348623157E308">
                    <columns>
                        <TableColumn fx:id="frontColumn" text="Front"/>
                        <TableColumn fx:id="backColumn" text="Back"/>
                        <TableColumn fx:id="statusColumn" text="Status"/>
                        <TableColumn fx:id="reviewColumn" text="Last Reviewed"/>
                        <TableColumn fx:id="creationColumn" text="Created"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </content>
</ScrollPane>