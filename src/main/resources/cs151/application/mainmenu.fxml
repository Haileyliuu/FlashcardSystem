<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.application.controller.MainMenuScene"
      spacing="20"
      style="-fx-padding: 20;">

    <children>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="searchField"
                           promptText="Search..."
                           maxWidth="400"/>
                <HBox HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <children>
                    <Label text="Create Deck" styleClass="header-text"/>
                    <Button fx:id="addDeckButton"
                            text="+"
                            styleClass="add-card"
                            onAction="#handleAddDeck"/>
                </children>
            </HBox>
            </children>
        </HBox>


        <HBox spacing="20">
            <children>
                <Label fx:id="allFlashcards"
                       text="All Flashcards"
                       underline="true"
                       prefWidth="180"
                       onMouseClicked="#handleAllFlashcard"/>

                <Line startY="10" endY="500" style="-fx-stroke: white;"/>

                <VBox spacing="20">
                    <children>
                        <Label fx:id="deckNumberLabel"
                               translateX="-10"
                               translateY="10"
                               style="-fx-font-size: 50;"/>

                        <TableView fx:id="deckTable" prefWidth="780">
                            <columns>
                                <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="557"/>
                            </columns>
                        </TableView>

                        <HBox fx:id="bottomActionBar" spacing="10" alignment="CENTER">
                            <Button fx:id="addFlashcardButton" text="Add Flashcard" style="-fx-background-color: green" onAction="#handleAddFlashcard"/>
                            <Button fx:id="editDeckButton" text="Edit Deck" onAction="#handleEditDeck"/>
                            <Button fx:id="deleteDeckButton" text="Delete Deck" style="-fx-background-color: red" onAction="#handleDeleteDeck"/>
                        </HBox>
                        
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>